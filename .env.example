# Portal Residencial Laguna — variáveis de ambiente (EXEMPLO, sem credenciais reais)
# Copie para ".env" no servidor (chmod 600) ou defina-as no gestor de processos.
# Nunca colocar o ficheiro .env no GitHub.

# Base de dados MySQL/MariaDB (cPanel): base laguna_residenciallaguna, utilizador laguna_laguna.
# Substitua PALAVRA_PASSE pela palavra-passe definida no cPanel (caracteres especiais em URL-encoding, ex.: @ → %40).
DATABASE_URL="mysql://laguna_laguna:PALAVRA_PASSE@localhost:3306/laguna_residenciallaguna"
# Ligações simultâneas à base de dados (opcional)
DB_POOL_SIZE=5

# Endereço público do portal (usado nas ligações de activação/redefinição e no cookie Secure)
APP_URL="https://residenciallaguna.ao"

# Pasta dos anexos — FORA da pasta pública e, de preferência, fora da pasta da aplicação
STORAGE_DIR="/home/UTILIZADOR/laguna-storage"
MAX_UPLOAD_MB=5

# Sessões (opcional): duração máxima e inactividade
SESSION_HOURS=12
SESSION_IDLE_MINUTES=120
# COOKIE_SECURE=true   # por omissão: true quando APP_URL começa por https://

# Fuso horário aplicado a datas/horas sem fuso (Angola, UTC+01:00)
APP_TZ_OFFSET="+01:00"

# Email (opcional). Sem SMTP_HOST, as ligações de activação/redefinição são entregues pela
# Gestão de Utilizadores (fluxo administrativo). Não altera a configuração de email do servidor.
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="Portal Residencial Laguna <no-reply@residenciallaguna.ao>"

# Etiqueta opcional na barra superior (ex.: "Ambiente de testes"). Deixar vazio em produção.
# NEXT_PUBLIC_ENV_LABEL=""
