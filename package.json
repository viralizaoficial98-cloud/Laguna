    "db:seed-users": "tsx --tsconfig tsconfig.json scripts/seed-users.ts",
    "db:verify": "tsx --tsconfig tsconfig.json scripts/db-verify.ts",
    "db:backup": "bash scripts/db-backup.sh",
    "users:activation-link": "tsx --tsconfig tsconfig.json scripts/activation-link.ts",
    "test:unit": "tsx --tsconfig tsconfig.json tests/unit.test.ts",
    "test:api": "tsx --tsconfig tsconfig.json tests/api.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "framer-motion": "^12.43.0",
    "jspdf": "^3.0.4",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "nodemailer": "^10.2.1",
    "prisma": "^7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
