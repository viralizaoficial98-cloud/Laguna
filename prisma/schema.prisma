// Portal Residencial Laguna — esquema MySQL/MariaDB (Prisma 7)
//
// Convenções:
// - Montantes em DECIMAL(14,2) (nunca vírgula flutuante).
// - Datas de calendário em DATE; instantes em DATETIME(3) (UTC).
// - Estruturas aninhadas (históricos, convidados, listas de verificação, metadados de anexos) em LONGTEXT
//   com JSON, para compatibilidade total entre MySQL 5.7+/8 e MariaDB 10.x.
// - Identificadores estáveis (string) herdados do cadastro actual — a importação é idempotente.
// - Restrições de integridade na base de dados: quota única por fracção/trimestre, uma reserva activa
//   por salão/data (reservation_slots), um comprovativo em validação por quota (pending_payment_slots),
//   um processo de desocupação activo por morador (active_moveouts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  administrador
  gestor
  financeiro
  morador
  porteiro
}

enum Typology {
  T2
  Duplex
}

enum QuotaStatus {
  pendente
  em_analise
  pago
  parcial
  em_atraso
}

enum PaymentStatus {
  em_analise
  aprovado
  rejeitado
}

enum ReservationStatus {
  em_espera
  pendente_pagamento
  em_validacao
  confirmada
  cancelada
  expirada
}

enum MoveOutStatus {
  solicitacao_recebida
  em_verificacao_financeira
  em_verificacao_operacional
  regularizacao_pendente
  aguardando_aprovacao
  autorizada
  concluida
  cancelada
}

enum UserStatus {
  pendente_activacao
  activo
  inactivo
  bloqueado
}

// ————————————————————————— Sistema —————————————————————————

/// Linha única: versão dos dados (sincronização) e trinco de escrita (SELECT … FOR UPDATE).
model AppMeta {
  id          Int      @id
  dataVersion Int      @default(0)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  @@map("app_meta")
}

model CondoSettings {
  id                   Int      @id
  quotaT2              Decimal  @db.Decimal(14, 2)
  quotaDuplex          Decimal  @db.Decimal(14, 2)
  dueDay               Int
  allowPartial         Boolean
  reservationFee       Decimal  @db.Decimal(14, 2)
  reservationHoldHours Int
  updatedAt            DateTime @updatedAt @db.DateTime(3)

  @@map("condo_settings")
}

// ————————————————————————— Autenticação e utilizadores —————————————————————————

model User {
  id                String     @id @db.VarChar(64)
  name              String     @db.VarChar(160)
  email             String     @unique @db.VarChar(190)
  role              Role
  title             String     @db.VarChar(160)
  status            UserStatus @default(pendente_activacao)
  /// Argon2id. Nulo enquanto a conta não for activada.
  passwordHash      String?    @db.VarChar(255)
  residentId        String?    @unique @db.VarChar(64)
  apartmentId       String?    @db.VarChar(64)
  block             String?    @db.VarChar(4)
  phone             String?    @db.VarChar(40)
  failedLogins      Int        @default(0)
  lockedUntil       DateTime?  @db.DateTime(3)
  lastLoginAt       DateTime?  @db.DateTime(3)
  passwordChangedAt DateTime?  @db.DateTime(3)
  createdAt         DateTime   @default(now()) @db.DateTime(3)
  updatedAt         DateTime   @updatedAt @db.DateTime(3)
  createdBy         String?    @db.VarChar(64)

  resident Resident?     @relation(fields: [residentId], references: [id], onDelete: SetNull)
  sessions AuthSession[]
  tokens   AuthToken[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model AuthSession {
  id         String   @id @db.VarChar(64)
  /// SHA-256 do token do cookie (o token em claro nunca é guardado).
  tokenHash  String   @unique @db.Char(64)
  userId     String   @db.VarChar(64)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  lastSeenAt DateTime @default(now()) @db.DateTime(3)
  expiresAt  DateTime @db.DateTime(3)
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

/// Tokens de activação e de redefinição de palavra-passe — utilização única, com prazo.
model AuthToken {
  id        String    @id @db.VarChar(64)
  tokenHash String    @unique @db.Char(64)
  userId    String    @db.VarChar(64)
  type      String    @db.VarChar(20)
  expiresAt DateTime  @db.DateTime(3)
  usedAt    DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  createdBy String?   @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_tokens")
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(190)
  userId    String?  @db.VarChar(64)
  ip        String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(255)
  success   Boolean
  reason    String?  @db.VarChar(60)
  at        DateTime @default(now()) @db.DateTime(3)

  @@index([email, at])
  @@index([ip, at])
  @@index([userId, at])
  @@map("login_attempts")
}

/// Histórico de alterações às contas (sem palavras-passe nem tokens).
model UserAuditLog {
  id         Int      @id @default(autoincrement())
  at         DateTime @default(now()) @db.DateTime(3)
  actorId    String?  @db.VarChar(64)
  actorName  String   @db.VarChar(160)
  targetId   String?  @db.VarChar(64)
  targetName String?  @db.VarChar(160)
  action     String   @db.VarChar(60)
  before     String?  @db.Text
  after      String?  @db.Text
  ip         String?  @db.VarChar(64)

  @@index([targetId, at])
  @@index([at])
  @@map("user_audit_log")
}

// ————————————————————————— Ficheiros —————————————————————————

/// Metadados dos ficheiros guardados fora da pasta pública (STORAGE_DIR).
model StoredFile {
  id           String   @id @db.VarChar(64)
  originalName String   @db.VarChar(255)
  mime         String   @db.VarChar(100)
  size         Int
  sha256       String   @db.Char(64)
  storagePath  String   @db.VarChar(255)
  ownerUserId  String?  @db.VarChar(64)
  ownerRole    Role?
  residentId   String?  @db.VarChar(64)
  /// fracção a que o anexo pertence (comprovativos carregados pela gestão em nome do morador)
  apartmentId  String?  @db.VarChar(64)
  /// proof | signature | declaration | document | photo | other — "signature" só é legível pelo próprio titular
  category     String?  @db.VarChar(30)
  createdAt    DateTime @default(now()) @db.DateTime(3)

  @@index([ownerUserId])
  @@index([apartmentId])
  @@map("stored_files")
}

// ————————————————————————— Cadastro —————————————————————————

model Apartment {
  id          String   @id @db.VarChar(64)
  block       String   @db.VarChar(4)
  number      String   @db.VarChar(8)
  floor       Int
  typology    Typology
  status      String   @db.VarChar(20)
  active      Boolean
  provisional Boolean
  ownerName   String   @db.VarChar(160)
  residentId  String?  @db.VarChar(64)
  notes       String?  @db.Text

  residents    Resident[]
  quotas       Quota[]
  payments     Payment[]
  reservations Reservation[]
  moveOuts     MoveOut[]
  occupancies  Occupancy[]
  charges      Charge[]
  visits       Visit[]
  holders      FractionHolder[]

  @@unique([block, number])
  @@map("apartments")
}

model Resident {
  id          String   @id @db.VarChar(64)
  name        String   @db.VarChar(160)
  email       String   @db.VarChar(190)
  phone       String   @db.VarChar(40)
  documentId  String   @db.VarChar(40)
  apartmentId String?  @db.VarChar(64)
  type        String   @db.VarChar(20)
  status      String   @db.VarChar(20)
  since       DateTime @db.Date
  dependents  String   @db.LongText
  notes       String?  @db.Text

  apartment Apartment? @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  user      User?

  @@index([apartmentId])
  @@map("residents")
}

model Occupancy {
  id           String    @id @db.VarChar(80)
  apartmentId  String    @db.VarChar(64)
  residentId   String    @db.VarChar(64)
  residentName String    @db.VarChar(160)
  from         DateTime  @db.Date
  to           DateTime? @db.Date

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)

  @@index([apartmentId])
  @@index([residentId])
  @@map("occupancies")
}

// ————————————————————————— Financeiro —————————————————————————

model Quota {
  id          String      @id @db.VarChar(80)
  apartmentId String      @db.VarChar(64)
  period      String      @db.VarChar(8)
  year        Int
  quarter     Int
  description String      @db.VarChar(160)
  amount      Decimal     @db.Decimal(14, 2)
  typology    Typology
  paidAmount  Decimal     @db.Decimal(14, 2)
  dueDate     DateTime    @db.Date
  status      QuotaStatus
  paymentId   String?     @db.VarChar(80)

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  payments  Payment[]

  @@unique([apartmentId, period])
  @@index([period])
  @@index([status])
  @@map("quotas")
}

model Payment {
  id              String        @id @db.VarChar(80)
  quotaId         String        @db.VarChar(80)
  apartmentId     String        @db.VarChar(64)
  residentId      String?       @db.VarChar(64)
  amount          Decimal       @db.Decimal(14, 2)
  method          String        @db.VarChar(20)
  reference       String        @db.VarChar(120)
  paidAt          DateTime      @db.DateTime(3)
  submittedAt     DateTime      @db.DateTime(3)
  proof           String?       @db.Text
  status          PaymentStatus
  reviewedBy      String?       @db.VarChar(160)
  reviewedByRole  Role?
  reviewedAt      DateTime?     @db.DateTime(3)
  note            String?       @db.Text
  validatedAmount Decimal?      @db.Decimal(14, 2)
  registeredBy    String?       @db.VarChar(160)
  receiptNumber   String?       @unique @db.VarChar(40)
  /// portal | presencial
  channel         String?       @db.VarChar(12)
  /// chave anti-duplicação do formulário (reenvio / clique repetido)
  clientKey       String?       @unique @db.VarChar(64)
  submittedBy     String?       @db.VarChar(160)

  quota     Quota     @relation(fields: [quotaId], references: [id], onDelete: Restrict)
  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)

  @@index([quotaId])
  @@index([status])
  @@index([apartmentId])
  @@map("payments")
}

/// No máximo um comprovativo "Em Validação" por quota (impede decisões contraditórias).
model PendingPaymentSlot {
  quotaId   String @id @db.VarChar(80)
  paymentId String @unique @db.VarChar(80)

  @@map("pending_payment_slots")
}

model Charge {
  id            String   @id @db.VarChar(80)
  apartmentId   String   @db.VarChar(64)
  description   String   @db.VarChar(255)
  justification String   @db.Text
  amount        Decimal  @db.Decimal(14, 2)
  date          DateTime @db.Date
  status        String   @db.VarChar(20)
  proposedBy    String   @db.VarChar(160)
  confirmedBy   String?  @db.VarChar(160)
  moveOutId     String?  @db.VarChar(80)

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)

  @@index([apartmentId])
  @@map("charges")
}

model Expense {
  id           String    @id @db.VarChar(80)
  date         DateTime  @db.Date
  period       String    @db.VarChar(8)
  category     String    @db.VarChar(40)
  description  String    @db.VarChar(255)
  /// valor da despesa (base, sem IVA)
  amount       Decimal   @db.Decimal(14, 2)
  supplierId   String?   @db.VarChar(80)
  supplierName String?   @db.VarChar(255)
  nif          String?   @db.VarChar(40)
  invoiceRef   String?   @db.VarChar(80)
  invoiceDate  DateTime? @db.Date
  dueDate      DateTime? @db.Date
  paymentDate  DateTime? @db.Date
  vat          Decimal?  @db.Decimal(14, 2)
  withholding  Decimal?  @db.Decimal(14, 2)
  /// líquido a pagar = valor + IVA − retenção
  netAmount    Decimal?  @db.Decimal(14, 2)
  budgetLineId String?   @db.VarChar(120)
  costCenter   String?   @db.VarChar(80)
  /// pendente | aprovada | paga | parcialmente_paga | anulada (nulo = registo antigo, pago)
  status       String?   @db.VarChar(24)
  paidAmount   Decimal?  @db.Decimal(14, 2)
  payments     String?   @db.LongText
  attachments  String?   @db.LongText
  notes        String?   @db.Text
  source       String?   @db.LongText
  history      String?   @db.LongText
  createdBy    String?   @db.VarChar(160)
  voidReason   String?   @db.Text

  @@index([period])
  @@index([supplierId])
  @@index([invoiceRef])
  @@index([budgetLineId])
  @@map("expenses")
}

model Supplier {
  id        String   @id @db.VarChar(80)
  name      String   @db.VarChar(255)
  nif       String?  @db.VarChar(40)
  email     String?  @db.VarChar(190)
  phone     String?  @db.VarChar(40)
  address   String?  @db.Text
  category  String?  @db.VarChar(80)
  notes     String?  @db.Text
  active    Boolean
  createdAt DateTime @db.DateTime(3)
  history   String?  @db.LongText

  @@index([nif])
  @@map("suppliers")
}

// ————————————————————————— Reservas de salões —————————————————————————

model Hall {
  id          String  @id @db.VarChar(64)
  name        String  @db.VarChar(120)
  description String? @db.Text
  capacity    Int?
  active      Boolean
  demo        Boolean

  reservations Reservation[]

  @@map("halls")
}

model Reservation {
  id             String            @id @db.VarChar(80)
  hallId         String            @db.VarChar(64)
  residentId     String            @db.VarChar(64)
  apartmentId    String            @db.VarChar(64)
  date           DateTime          @db.Date
  startTime      String            @db.VarChar(5)
  endTime        String            @db.VarChar(5)
  eventType      String            @db.VarChar(60)
  eventName      String            @db.VarChar(160)
  expectedGuests Int
  guests         String            @db.LongText
  notes          String?           @db.Text
  fee            Decimal           @db.Decimal(14, 2)
  status         ReservationStatus
  createdAt      DateTime          @db.DateTime(3)
  expiresAt      DateTime?         @db.DateTime(3)
  payment        String?           @db.Text
  history        String            @db.LongText

  hall      Hall      @relation(fields: [hallId], references: [id], onDelete: Restrict)
  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)

  @@index([hallId, date])
  @@index([residentId])
  @@map("reservations")
}

/// Uma reserva activa (pendente de pagamento, em validação ou confirmada) por salão e data.
model ReservationSlot {
  hallId        String   @db.VarChar(64)
  date          DateTime @db.Date
  reservationId String   @unique @db.VarChar(80)

  @@id([hallId, date])
  @@map("reservation_slots")
}

// ————————————————————————— Desocupação —————————————————————————

model MoveOut {
  id            String        @id @db.VarChar(80)
  reference     String        @unique @db.VarChar(20)
  residentId    String        @db.VarChar(64)
  residentName  String        @db.VarChar(160)
  apartmentId   String        @db.VarChar(64)
  block         String        @db.VarChar(4)
  number        String        @db.VarChar(8)
  typology      Typology
  plannedDate   DateTime      @db.Date
  reason        String?       @db.Text
  contact       String        @db.VarChar(120)
  notes         String?       @db.Text
  status        MoveOutStatus
  createdAt     DateTime      @db.DateTime(3)
  financial     String        @db.Text
  operational   String        @db.LongText
  authorization String?       @db.Text
  completedAt   DateTime?     @db.DateTime(3)
  history       String        @db.LongText

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)

  @@index([residentId])
  @@index([status])
  @@map("move_outs")
}

/// Um processo de desocupação activo por morador.
model ActiveMoveOut {
  residentId String @id @db.VarChar(64)
  moveOutId  String @unique @db.VarChar(80)

  @@map("active_moveouts")
}

// ————————————————————————— Comunicação —————————————————————————

model Circular {
  id          String   @id @db.VarChar(80)
  sequence    Int
  year        Int
  number      String   @db.VarChar(40)
  subject     String   @db.VarChar(255)
  body        String   @db.LongText
  closing     String?  @db.Text
  date        DateTime @db.Date
  status      String   @db.VarChar(20)
  recipients  String   @db.Text
  author      String   @db.VarChar(160)
  authorTitle String   @db.VarChar(160)
  publishedAt DateTime? @db.DateTime(3)
  updatedAt   DateTime @db.DateTime(3)

  @@unique([year, sequence])
  @@map("circulars")
}

model Notice {
  id          String    @id @db.VarChar(80)
  title       String    @db.VarChar(255)
  body        String    @db.LongText
  category    String    @db.VarChar(40)
  date        DateTime  @db.Date
  visibility  String    @db.VarChar(20)
  status      String    @db.VarChar(20)
  author      String    @db.VarChar(160)
  pinned      Boolean?
  pdf         String?   @db.Text
  publishedAt DateTime? @db.DateTime(3)
  withdrawnAt DateTime? @db.DateTime(3)
  updatedAt   DateTime  @db.DateTime(3)

  @@map("notices")
}

model CondoDocument {
  id          String   @id @db.VarChar(80)
  title       String   @db.VarChar(255)
  description String   @db.Text
  category    String   @db.VarChar(40)
  fileType    String   @db.VarChar(10)
  size        Int
  updatedAt   DateTime @db.Date
  visibility  String   @db.VarChar(20)
  uploadedBy  String   @db.VarChar(160)
  file        String?  @db.Text

  @@map("documents")
}

model Notification {
  id         String   @id @db.VarChar(80)
  title      String   @db.VarChar(255)
  body       String   @db.Text
  at         DateTime @db.DateTime(3)
  read       Boolean
  roles      String   @db.VarChar(255)
  href       String?  @db.VarChar(255)
  residentId String?  @db.VarChar(64)
  readBy     String?  @db.Text

  @@index([at])
  @@map("notifications")
}

// ————————————————————————— Portaria —————————————————————————

model Visit {
  id          String   @id @db.VarChar(80)
  kind        String   @db.VarChar(20)
  residentId  String   @db.VarChar(64)
  apartmentId String   @db.VarChar(64)
  date        DateTime @db.Date
  time        String   @db.VarChar(5)
  notes       String?  @db.Text
  guests      String   @db.LongText
  eventName   String?  @db.VarChar(160)
  eventType   String?  @db.VarChar(40)
  status      String   @db.VarChar(20)
  createdAt   DateTime @db.DateTime(3)
  updatedAt   DateTime @db.DateTime(3)

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  checks    VisitCheck[]

  @@index([date])
  @@index([residentId])
  @@map("visits")
}

model VisitCheck {
  id      String   @id @db.VarChar(80)
  visitId String   @db.VarChar(80)
  guestId String   @db.VarChar(80)
  type    String   @db.VarChar(10)
  at      DateTime @db.DateTime(3)
  by      String   @db.VarChar(160)

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Restrict)

  @@index([visitId])
  @@map("visit_checks")
}

model AccessLog {
  id          String   @id @db.VarChar(80)
  at          DateTime @db.DateTime(3)
  type        String   @db.VarChar(10)
  person      String   @db.VarChar(160)
  category    String   @db.VarChar(20)
  apartmentId String?  @db.VarChar(64)
  gate        String   @db.VarChar(80)

  @@index([at])
  @@map("access_logs")
}

// ————————————————————————— Operações —————————————————————————

model Occurrence {
  id          String    @id @db.VarChar(80)
  title       String    @db.VarChar(255)
  description String    @db.Text
  category    String    @db.VarChar(40)
  priority    String    @db.VarChar(10)
  status      String    @db.VarChar(20)
  block       String?   @db.VarChar(4)
  apartmentId String?   @db.VarChar(64)
  location    String    @db.VarChar(255)
  assignee    String?   @db.VarChar(160)
  elevatorId  String?   @db.VarChar(64)
  residentId  String?   @db.VarChar(64)
  photos      String?   @db.LongText
  resolution  String?   @db.Text
  createdAt   DateTime  @db.DateTime(3)
  resolvedAt  DateTime? @db.DateTime(3)
  reportedBy  String    @db.VarChar(160)
  history     String    @db.LongText

  @@index([status])
  @@index([residentId])
  @@map("occurrences")
}

model Elevator {
  id              String    @id @db.VarChar(64)
  block           String    @db.VarChar(4)
  code            String    @db.VarChar(40)
  status          String    @db.VarChar(20)
  lastMaintenance DateTime? @db.Date
  nextMaintenance DateTime? @db.Date
  provider        String    @db.VarChar(160)
  notes           String?   @db.Text
  demo            Boolean
  history         String    @db.LongText

  @@map("elevators")
}

model OpsTask {
  id            String    @id @db.VarChar(80)
  area          String    @db.VarChar(20)
  type          String    @db.VarChar(60)
  title         String    @db.VarChar(255)
  location      String    @db.VarChar(255)
  block         String?   @db.VarChar(4)
  responsible   String    @db.VarChar(160)
  frequency     String?   @db.VarChar(20)
  scheduledDate DateTime  @db.Date
  dueDate       DateTime? @db.Date
  executedDate  DateTime? @db.Date
  status        String    @db.VarChar(20)
  equipment     String?   @db.VarChar(160)
  estimatedCost Decimal?  @db.Decimal(14, 2)
  actualCost    Decimal?  @db.Decimal(14, 2)
  inspection    String?   @db.Text
  notes         String?   @db.Text

  @@index([area, scheduledDate])
  @@map("ops_tasks")
}

// ————————————————————————— Auditoria e importação —————————————————————————

model AuditEntry {
  id       String   @id @db.VarChar(80)
  at       DateTime @db.DateTime(3)
  by       String   @db.VarChar(160)
  role     Role
  action   String   @db.VarChar(120)
  entity   String   @db.VarChar(40)
  entityId String   @db.VarChar(80)
  details  String?  @db.Text

  @@index([at])
  @@index([entity, entityId])
  @@map("audit_entries")
}

/// Registo técnico de todas as operações recebidas pelo servidor (aceites e recusadas).
model ActionLog {
  id         Int      @id @default(autoincrement())
  at         DateTime @default(now()) @db.DateTime(3)
  userId     String?  @db.VarChar(64)
  role       Role?
  action     String   @db.VarChar(60)
  ok         Boolean
  error      String?  @db.VarChar(500)
  durationMs Int
  changes    Int      @default(0)

  @@index([at])
  @@index([userId, at])
  @@map("action_log")
}

model ImportRun {
  id        Int      @id @default(autoincrement())
  at        DateTime @default(now()) @db.DateTime(3)
  source    String   @db.VarChar(40)
  by        String   @db.VarChar(160)
  mode      String   @db.VarChar(40)
  summary   String   @db.LongText

  @@map("import_runs")
}

// ————————————————————————— Proprietários e inquilinos —————————————————————————

/// Pessoa ou entidade (proprietário, inquilino ou ambos). Pode não ter conta no portal.
model Party {
  id             String   @id @db.VarChar(64)
  name           String   @db.VarChar(255)
  /// nome normalizado (sem acentos, pontuação e maiúsculas) — conciliação e prevenção de duplicados
  normalizedName String   @db.VarChar(255)
  kind           String?  @db.VarChar(20)
  nif            String?  @db.VarChar(40)
  email          String?  @db.VarChar(190)
  phone          String?  @db.VarChar(40)
  phone2         String?  @db.VarChar(40)
  address        String?  @db.Text
  notes          String?  @db.Text
  residentId     String?  @db.VarChar(64)
  source         String?  @db.LongText
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.DateTime(3)
  updatedAt      DateTime @updatedAt @db.DateTime(3)
  createdBy      String?  @db.VarChar(160)

  holdings FractionHolder[]

  @@index([normalizedName])
  @@index([nif])
  @@map("parties")
}

/// Titularidade (proprietário) e arrendamento (inquilino) de uma fracção, com histórico.
model FractionHolder {
  id          String    @id @db.VarChar(64)
  apartmentId String    @db.VarChar(64)
  partyId     String    @db.VarChar(64)
  /// proprietario | inquilino
  role        String    @db.VarChar(12)
  from        DateTime? @db.Date
  to          DateTime? @db.Date
  active      Boolean
  source      String?   @db.VarChar(60)
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  createdBy   String?   @db.VarChar(160)
  endedBy     String?   @db.VarChar(160)
  endReason   String?   @db.Text

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  party     Party     @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@index([apartmentId, role])
  @@index([partyId])
  @@map("fraction_holders")
}

/// Um proprietário activo e um inquilino activo por fracção (restrição na base de dados).
model ActiveHolderSlot {
  apartmentId String @db.VarChar(64)
  role        String @db.VarChar(12)
  holderId    String @unique @db.VarChar(64)

  @@id([apartmentId, role])
  @@map("active_holder_slots")
}

// ————————————————————————— Declarações e assinatura —————————————————————————

model DeclarationType {
  code              String  @id @db.VarChar(40)
  name              String  @db.VarChar(160)
  description       String? @db.Text
  /// texto com marcadores {{nome}}, {{fraccao}}, {{bloco}}, {{tipologia}}, {{finalidade}}, …
  template          String  @db.LongText
  /// nenhum | residencia | titularidade | sem_divida | situacao_financeira
  requirement       String  @db.VarChar(30)
  active            Boolean @default(true)
  residentCanRequest Boolean @default(true)
  position          Int     @default(0)

  @@map("declaration_types")
}

model Declaration {
  id                String    @id @db.VarChar(64)
  /// número único: DEC-AAAA-NNNN
  number            String    @unique @db.VarChar(20)
  typeCode          String    @db.VarChar(40)
  apartmentId       String    @db.VarChar(64)
  residentId        String?   @db.VarChar(64)
  partyId           String?   @db.VarChar(64)
  subjectName       String    @db.VarChar(255)
  purpose           String?   @db.Text
  /// solicitada | em_analise | aguardando_assinatura | emitida | rejeitada | cancelada | anulada
  status            String    @db.VarChar(24)
  /// portal | presencial
  channel           String    @db.VarChar(12)
  requestedByUserId String?   @db.VarChar(64)
  requestedByName   String    @db.VarChar(160)
  requestedAt       DateTime  @db.DateTime(3)
  content           String?   @db.LongText
  checks            String?   @db.LongText
  reviewedBy        String?   @db.VarChar(160)
  rejectionReason   String?   @db.Text
  signedByUserId    String?   @db.VarChar(64)
  signerName        String?   @db.VarChar(160)
  signerTitle       String?   @db.VarChar(160)
  signedAt          DateTime? @db.DateTime(3)
  signatureId       String?   @db.VarChar(64)
  /// imagem | (futuro) prestador de assinatura electrónica qualificada
  signatureProvider String?   @db.VarChar(40)
  pdfFileId         String?   @db.VarChar(64)
  pdfSha256         String?   @db.Char(64)
  verificationCode  String?   @unique @db.VarChar(32)
  revokedAt         DateTime? @db.DateTime(3)
  revokedBy         String?   @db.VarChar(160)
  revokeReason      String?   @db.Text
  history           String    @db.LongText
  updatedAt         DateTime  @updatedAt @db.DateTime(3)

  @@index([apartmentId])
  @@index([residentId])
  @@index([status])
  @@map("declarations")
}

/// Imagem de assinatura do utilizador (privada). Uma activa por utilizador.
model Signature {
  id          String    @id @db.VarChar(64)
  userId      String    @db.VarChar(64)
  fileId      String    @db.VarChar(64)
  displayName String    @db.VarChar(160)
  title       String    @db.VarChar(160)
  active      Boolean
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  revokedAt   DateTime? @db.DateTime(3)

  @@index([userId])
  @@map("signatures")
}

// ————————————————————————— Orçamento e receitas —————————————————————————

model Budget {
  id            String   @id @db.VarChar(64)
  year          Int      @unique
  name          String   @db.VarChar(160)
  /// rascunho | aprovado
  status        String   @db.VarChar(20)
  source        String?  @db.VarChar(255)
  notes         String?  @db.Text
  /// informação de origem (ex.: disponibilidades em caixa por trimestre, colunas auxiliares)
  sourceInfo    String?  @db.LongText
  createdAt     DateTime @default(now()) @db.DateTime(3)
  createdBy     String?  @db.VarChar(160)

  lines BudgetLine[]

  @@map("budgets")
}

model BudgetLine {
  id               String  @id @db.VarChar(120)
  budgetId         String  @db.VarChar(64)
  parentId         String? @db.VarChar(120)
  /// receita | despesa | fundo
  kind             String  @db.VarChar(12)
  name             String  @db.VarChar(255)
  position         Int
  /// orçamento anual aprovado (folhas). Nos grupos é calculado a partir das folhas.
  annualAmount     Decimal @db.Decimal(16, 2)
  /// 12 valores mensais (JSON); nulo = anual ÷ 12
  monthly          String? @db.Text
  isGroup          Boolean
  /// parte das quotas atribuída a esta rubrica (ex.: 0,90 despesas correntes / 0,10 fundo de reserva)
  quotaShare       Decimal? @db.Decimal(6, 4)
  note             String? @db.Text
  sourceRaw        String? @db.LongText

  budget     Budget            @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  executions BudgetExecution[]

  @@index([budgetId])
  @@map("budget_lines")
}

/// Execução histórica por trimestre (ficheiro de origem ou lançamento manual) — separada dos movimentos do sistema.
model BudgetExecution {
  id        String   @id @db.VarChar(64)
  lineId    String   @db.VarChar(120)
  period    String   @db.VarChar(8)
  amount    Decimal  @db.Decimal(16, 2)
  /// ficheiro | manual
  source    String   @db.VarChar(20)
  note      String?  @db.Text
  createdAt DateTime @default(now()) @db.DateTime(3)
  createdBy String?  @db.VarChar(160)

  line BudgetLine @relation(fields: [lineId], references: [id], onDelete: Restrict)

  @@unique([lineId, period, source])
  @@map("budget_executions")
}

/// Receitas não provenientes de quotas (antenas, água, recuperações, outras).
model Revenue {
  id           String   @id @db.VarChar(64)
  date         DateTime @db.Date
  period       String   @db.VarChar(8)
  budgetLineId String?  @db.VarChar(120)
  category     String   @db.VarChar(80)
  description  String   @db.VarChar(255)
  amount       Decimal  @db.Decimal(14, 2)
  apartmentId  String?  @db.VarChar(64)
  reference    String?  @db.VarChar(120)
  /// registada | anulada
  status       String   @db.VarChar(16)
  attachments  String?  @db.LongText
  createdBy    String   @db.VarChar(160)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  voidReason   String?  @db.Text

  @@index([period])
  @@map("revenues")
}
